# Copy this file to .env and fill in the values you need.

# Set to "true" behind HTTPS in production so the session cookie requires TLS.
COOKIE_SECURE=false

# Kroger Product API (allergen lookups). Optional -- lookups are skipped
# if these are unset.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Google reCAPTCHA v2 (checkbox), used on signup and login.
# Get a site key + secret key at https://www.google.com/recaptcha/admin
# WARNING: if RECAPTCHA_SECRET_KEY is left unset, CAPTCHA verification is
# silently skipped. This is a local dev/test convenience only -- never
# leave it unset in production.
RECAPTCHA_SECRET_KEY=

# SendGrid (password reset emails). Get an API key at https://sendgrid.com
# and verify a sender address there first.
# WARNING: if SENDGRID_API_KEY or RESET_EMAIL_FROM is left unset, reset
# links are printed to the server console instead of emailed -- a local
# dev/test convenience only.
SENDGRID_API_KEY=
RESET_EMAIL_FROM=no-reply@example.com

# Base URL of the frontend, used to build password-reset links.
FRONTEND_URL=http://localhost:5173
