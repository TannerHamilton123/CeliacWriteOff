# Copy this file to .env and fill in the values you need.

VITE_API_URL=http://localhost:8000

# Google reCAPTCHA v2 site key (pair it with RECAPTCHA_SECRET_KEY in the
# backend's .env). If left unset, the CAPTCHA widget is not shown and
# signup/login submit without it -- matches the backend's bypass behavior
# for local dev/test only.
VITE_RECAPTCHA_SITE_KEY=
